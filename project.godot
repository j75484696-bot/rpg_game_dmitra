; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="rpg_game_dmitra"
run/main_scene="res://scenes/map/map.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Elements="*res://core/Elements.gd"
Party="*res://core/Party.gd"
Inventory="*res://core/Inventory.gd"
Targeting="*res://core/Targeting.gd"
Transitions="*res://core/Transitions.gd"
Combat="*res://core/Combat.gd"
Actions="*res://core/Actions.gd"
EnemyAI="*res://core/EnemyAI.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://ui/themes/main.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
