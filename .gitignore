# ========== GODOT 4 ==========
# The big one — Godot's auto-generated cache/import folder. NEVER commit this.
.godot/

# Old import cache (Godot 3 leftover, harmless to keep)
.import/

# ========== EXPORTED BUILDS ==========
# Your compiled game — rebuildable, don't bloat the repo with it
build/
builds/
export/
exports/
*.exe
*.pck
*.zip
*.dmg
*.apk
*.x86_64

# ========== EXPORT PRESETS ==========
# export_presets.cfg IS committed: CI needs it for the Web export, and the Web
# preset holds no keys. If a signed preset (Android/iOS) is ever added, put its
# keystore/passwords in GitLab CI variables, never in this file.

# ========== C# / MONO (only if you add C#, harmless otherwise) ==========
.mono/
mono_crash.*
data_*/
*.csproj
*.sln

